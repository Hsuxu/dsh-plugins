{
  "name": "dsh-sidebar-session-status",
  "version": "0.1.0",
  "private": true,
  "description": "Pins the active project to the top of the sidebar and tints session rows by state: active, completed, needs review, interrupted, or failed.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "session-status"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/projection.js && node --check lib/client.js",
    "test": "node test/projection.test.js && node test/client.test.js"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  }
}
