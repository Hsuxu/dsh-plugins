{
  "name": "dsh-session-recovery",
  "version": "0.1.0",
  "private": true,
  "description": "Restores sessions that failed or exited abnormally after DSH restarts.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  }
}
