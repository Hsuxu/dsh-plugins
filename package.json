{
  "name": "dsh-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "A collection of DeepSeek Harness plugins, managed as a pnpm monorepo.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "new": "node scripts/new-plugin.mjs",
    "check": "node scripts/check-workspace.mjs",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test"
  }
}
